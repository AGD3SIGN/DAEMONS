; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Daemons"
config/description="GBA-style IT-themed monster tamer."
config/version="0.1.0"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DataRegistry="*res://autoload/data_registry.gd"
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"
ScreenFitter="*res://autoload/screen_fitter.gd"
Settings="*res://autoload/settings.gd"
InputPrompts="*res://autoload/input_prompts.gd"
TouchControls="*res://autoload/touch_controls.gd"
AppLifecycle="*res://autoload/app_lifecycle.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/custom_font="res://assets/fonts/PressStart2P-Regular.ttf"

